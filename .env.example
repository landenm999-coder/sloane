# ---------------------------------------------------------------------------
# Sloane. Copy to .env and fill in. `python scripts/doctor.py` tells you
# exactly what is still missing.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → Database → Connection string (URI).
# Use the pooled connection string; the direct one caps connections low.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:6543/postgres

# --- THE UPGRADE LEVER -----------------------------------------------------
# These two lines are the whole free-to-paid migration. Nothing else changes.
#   claude_code  `claude -p`, billed to the Claude Pro subscription   $0
#   groq         free tier: 1K req/day, 200K tok/day                  $0
#   anthropic    Sonnet 5 (~$5.40/mo) / Haiku 4.5 (~$1.80/mo)
# Flip these only once Sloane starts eating the Claude limits Landen wants
# for schoolwork. Not before.
MAIN_PROVIDER=claude_code
BULK_PROVIDER=groq

# --- claude code CLI -------------------------------------------------------
CLAUDE_CLI=claude
# Optional. Empty = the CLI's default for your plan. A heavier model spends
# your Pro limits faster; set it only if replies need the extra depth.
CLAUDE_CLI_MODEL=
# Seconds before the router gives up and degrades to the next provider.
CLAUDE_CLI_TIMEOUT=45

# --- groq: console.groq.com/keys -------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- anthropic: only needed when a provider above is `anthropic` -----------
ANTHROPIC_API_KEY=
ANTHROPIC_MAIN_MODEL=claude-sonnet-5
ANTHROPIC_BULK_MODEL=claude-haiku-4-5
# Sonnet 5 accepts effort; Haiku 4.5 rejects it. Leave empty unless both
# configured models support it.
ANTHROPIC_EFFORT=

# --- telegram: @BotFather --------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Landen's chat id. Until it is set she answers every message with that
# chat's id and nothing else -- so message the bot once and copy the number.
TELEGRAM_CHAT_ID=

# --- school (P1). Everything here is READ-ONLY. ----------------------------
# Canvas: Account -> Settings -> New Access Token.
# This token can read all of his coursework. Treat it like a password.
CANVAS_BASE_URL=https://YOURDISTRICT.instructure.com
CANVAS_TOKEN=

# Google Calendar -> Settings for my calendars -> Integrate calendar ->
# "Secret address in iCal format". The URL *is* the credential: anyone who has
# it can read the whole calendar. Never paste it anywhere public.
CALENDAR_ICS_URL=

# How far either side of today to sync, and how far ahead to generate shifts.
SYNC_PAST_DAYS=7
SYNC_FUTURE_DAYS=45
SHIFT_WEEKS_AHEAD=6

# --- gmail (P4). Optional. Setup: DEPLOY.md section 7c. -----------------------
# A Google Cloud "Desktop app" OAuth client. Publish the app In production, or
# the refresh token dies every 7 days.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Leave blank: `python3 scripts/gmail_auth.py` fills it in for you.
GMAIL_REFRESH_TOKEN=
# Mail from these domains is school: she saves a draft, you press send.
SCHOOL_EMAIL_DOMAINS=dcsdk12.org
INBOX_BATCH=40
INBOX_MAX_DRAFTS=3

# --- capture intake. Optional; DEPLOY.md section 7d. ------------------------
# Password for POST /capture, the one endpoint reachable from off the box
# (over Tailscale). Blank or shorter than 32 characters = off. Generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CAPTURE_TOKEN=
# The Capture web app's origin(s), comma-separated, so its page may POST to
# /capture from the browser on your phone. CORS is scoped to /capture only.
# Example: https://capture-yourname.vercel.app
CORS_ORIGINS=

# --- voice replies (P3) -----------------------------------------------------
# A voice note in gets a voice note out. Every failure falls back to text.
SPEAK_PROVIDER=groq
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# autumn, diana, hannah, austin, daniel, troy
GROQ_TTS_VOICE=hannah
# Optional local fallback with no daily cap. See DEPLOY.md.
PIPER_BIN=piper
PIPER_VOICE=
# Groq's free TTS allowance is ~100 requests/day; past this, replies are text.
DAILY_SPEAK_BUDGET=80
# Briefs to send as voice notes (comma-separated), e.g. morning_brief
VOICE_BRIEFS=

# --- embeddings ------------------------------------------------------------
# bge-small-en-v1.5, 384 dims, local. No key, no per-token cost.
# Weights are fetched from huggingface.co on FIRST USE (~130 MB) then cached.
# Point this at a mounted volume or every rebuild re-downloads them.
EMBED_CACHE_DIR=/var/lib/sloane/models
# Verify them once with: python scripts/doctor.py --warm
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

# --- backups ----------------------------------------------------------------
# Nightly JSON of what only you could recreate. Empty = <EMBED_CACHE_DIR>/backups
# (the Docker `models` volume). To restore a table, the file is plain JSON rows.
BACKUP_DIR=
BACKUP_KEEP=14

# --- skills (sloane/skills/) -------------------------------------------------
# Lists, countdowns, flashcards, habits, clients, the study plan, focus,
# birthdays and money need no setup. Switch one off by name, comma-separated:
SKILLS_DISABLED=
# Weather (Open-Meteo: free, no key). "latitude,longitude"; blank = no weather.
# Parker, CO is 39.52,-104.76.
WEATHER_LOCATION=39.52,-104.76
WEATHER_UNITS=fahrenheit
# The study plan (/plan): when your own time starts and ends, HH:MM. School
# days start after school; your shift, plus the commute each way, is carved out.
PLAN_SCHOOL_DAY_START=15:00
PLAN_WEEKEND_START=09:00
PLAN_BEDTIME=22:30
PLAN_COMMUTE_MINUTES=30
# Hourly pay, for "about $240 earned this week" from your shifts. 0 = off.
PAY_RATE=0

# --- behaviour -------------------------------------------------------------
TIMEZONE=America/Denver
# Leave unset outside Docker: the API then listens on 127.0.0.1 only. The image
# sets 0.0.0.0 inside the container; compose publishes it on loopback.
# BIND_HOST=127.0.0.1
LOG_LEVEL=INFO

# Context budget per tier, in tokens. Tiers 1 and 2 ride in every prompt.
BUDGET_STATE=1500
BUDGET_WORKING_SET=1500
BUDGET_EPISODES=2000
# FACTS: school rows first, then the skills' lines (weather, lists, habits ...).
BUDGET_ENTITIES=2000

# Ceilings for SCHEDULED work only -- your own messages are never rationed.
# A brief over budget is deferred and says why in /jobs.
DAILY_JOB_BUDGET=40
DAILY_BULK_BUDGET=800

# Retrieval decay: cosine similarity * 0.5 ** (age_days / half_life).
RECENCY_HALF_LIFE_DAYS=14
RETRIEVAL_LIMIT=12
