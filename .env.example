# ---------------------------------------------------------------------------
# Sloane. Copy to .env and fill in. `python scripts/doctor.py` tells you
# exactly what is still missing.
# ---------------------------------------------------------------------------

# Supabase → Connect → Session pooler (port 5432). Not the Transaction pooler
# (6543), and not the Direct connection (IPv6 only). Letters and numbers in the
# password: @ # / ? $ break the address.
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- THE UPGRADE LEVER -----------------------------------------------------
# These two lines are the whole free-to-paid migration. Nothing else changes.
#   claude_code  `claude -p`, billed to the Claude Pro subscription   $0
#   groq         free tier: 1K req/day, 200K tok/day                  $0
#   anthropic    Sonnet 5 (~$5.40/mo) / Haiku 4.5 (~$1.80/mo)
#   local        a model on your own hardware (LOCAL_MODELS.md)       $0
# Flip these only once Sloane starts eating the Claude limits Landen wants
# for schoolwork. Not before.
MAIN_PROVIDER=claude_code
BULK_PROVIDER=groq
# Talking out loud in the control room: a fast model answers quick back-and-forth
# in a second or two, and hands anything she has to DO to MAIN_PROVIDER. Blank =
# every spoken turn on MAIN_PROVIDER (slower to start talking, never less able).
QUICK_PROVIDER=groq

# --- claude code CLI -------------------------------------------------------
CLAUDE_CLI=claude
# Optional. Empty = the CLI's default for your plan. A heavier model spends
# your Pro limits faster; set it only if replies need the extra depth.
CLAUDE_CLI_MODEL=
# Seconds before the router gives up and degrades to the next provider.
CLAUDE_CLI_TIMEOUT=45

# --- groq: console.groq.com/keys -------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- a local model: optional; LOCAL_MODELS.md --------------------------------
# Ollama (or llama.cpp, LM Studio) on hardware you own, e.g. a Raspberry Pi 5.
# Set both and it's the last fallback when every cloud lane is down;
# BULK_PROVIDER=local or MAIN_PROVIDER=local puts it first in that lane.
LOCAL_BASE_URL=
LOCAL_MODEL=
# LOCAL_API_KEY=
# LOCAL_TIMEOUT=180
# Voice notes transcribed locally too (a Whisper server, e.g. speaches):
# LOCAL_STT_MODEL=Systran/faster-whisper-small
# LOCAL_STT_BASE_URL=http://raspberrypi:8000/v1

# --- anthropic: only needed when a provider above is `anthropic` -----------
ANTHROPIC_API_KEY=
ANTHROPIC_MAIN_MODEL=claude-sonnet-5
ANTHROPIC_BULK_MODEL=claude-haiku-4-5
# Sonnet 5 accepts effort; Haiku 4.5 rejects it. Leave empty unless both
# configured models support it.
ANTHROPIC_EFFORT=

# --- the control room: /app (DEPLOY section 7e) -----------------------------
# Its password: 32+ characters. The installer makes one; unset, /app is off.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_TOKEN=

# --- telegram: @BotFather --------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Landen's chat id. Until it is set she answers every message with that
# chat's id and nothing else -- so message the bot once and copy the number.
TELEGRAM_CHAT_ID=

# --- school (P1). Everything here is READ-ONLY. ----------------------------
# Canvas: Account -> Settings -> New Access Token.
# This token can read all of his coursework. Treat it like a password.
CANVAS_BASE_URL=https://YOURDISTRICT.instructure.com
CANVAS_TOKEN=
# No "New Access Token" button (some districts turn it off)? Leave the token
# blank and use Canvas → Calendar → Calendar Feed instead. Due dates only: no
# grades or turned-in state. A password, like the token.
CANVAS_FEED_URL=

# Google Calendar -> Settings for my calendars -> Integrate calendar ->
# "Secret address in iCal format". The URL *is* the credential: anyone who has
# it can read the whole calendar. Never paste it anywhere public.
CALENDAR_ICS_URL=

# How far either side of today to sync, and how far ahead to generate shifts.
SYNC_PAST_DAYS=7
SYNC_FUTURE_DAYS=45
SHIFT_WEEKS_AHEAD=6

# --- gmail (P4). Optional. Setup: DEPLOY.md section 7c. -----------------------
# A Google Cloud "Desktop app" OAuth client. Publish the app In production, or
# the refresh token dies every 7 days.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Leave blank: `python3 scripts/gmail_auth.py` fills it in for you.
GMAIL_REFRESH_TOKEN=
# Mail from these domains is school: she saves a draft, you press send.
SCHOOL_EMAIL_DOMAINS=dcsdk12.org
INBOX_BATCH=40
INBOX_MAX_DRAFTS=3

# --- capture intake. Optional; DEPLOY.md section 7d. ------------------------
# Password for POST /capture, the one endpoint reachable from off the box
# (over Tailscale). Blank or shorter than 32 characters = off. Generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CAPTURE_TOKEN=
# The Capture web app's origin(s), comma-separated, so its page may POST to
# /capture from the browser on your phone. CORS is scoped to /capture only.
# Example: https://capture-yourname.vercel.app
CORS_ORIGINS=

# --- voice replies (P3) -----------------------------------------------------
# A voice note in gets a voice note out. Every failure falls back to text.
SPEAK_PROVIDER=groq
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# autumn, diana, hannah, austin, daniel, troy
GROQ_TTS_VOICE=hannah
# A local voice with no daily cap: a Piper voice name (fetched once into
# EMBED_CACHE_DIR) or a path to an .onnx. The fallback when Groq is out -- or,
# with SPEAK_PROVIDER=piper, her main voice. For a British voice (the full
# JARVIS): SPEAK_PROVIDER=piper and PIPER_VOICE=en_GB-cori-medium. Others:
# en_GB-jenny_dioco-medium, en_GB-alba-medium (Scottish), en_GB-alan-medium
# (male), en_US-amy-medium. See DEPLOY.md 7b.
PIPER_BIN=piper
PIPER_VOICE=
# Groq's free TTS allowance is ~100 requests/day; past this, replies are text.
DAILY_SPEAK_BUDGET=80
# Briefs to send as voice notes (comma-separated), e.g. morning_brief
VOICE_BRIEFS=

# --- embeddings ------------------------------------------------------------
# bge-small-en-v1.5, 384 dims, local. No key, no per-token cost.
# Weights are fetched from huggingface.co on FIRST USE (~130 MB) then cached.
# Point this at a mounted volume or every rebuild re-downloads them.
EMBED_CACHE_DIR=/var/lib/sloane/models
# Verify them once with: python scripts/doctor.py --warm
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

# --- backups ----------------------------------------------------------------
# Nightly JSON of what only you could recreate. Empty = <EMBED_CACHE_DIR>/backups
# (the Docker `models` volume). To restore a table, the file is plain JSON rows.
BACKUP_DIR=
BACKUP_KEEP=14

# --- skills (sloane/skills/) -------------------------------------------------
# Lists, countdowns, flashcards, habits, clients, the study plan, focus,
# birthdays, money, workouts, markets and news need no setup. Switch one off by
# name, comma-separated (e.g. SKILLS_DISABLED=deca,cards):
SKILLS_DISABLED=
# Weather (Open-Meteo: free, no key). "latitude,longitude"; blank = no weather.
# Parker, CO is 39.52,-104.76.
WEATHER_LOCATION=39.52,-104.76
WEATHER_UNITS=fahrenheit
# The study plan (/plan): when your own time starts and ends, HH:MM. School
# days start after school; your shift, plus the commute each way, is carved out.
PLAN_SCHOOL_DAY_START=15:00
PLAN_WEEKEND_START=09:00
PLAN_BEDTIME=22:30
PLAN_COMMUTE_MINUTES=30
# Hourly pay, for "about $240 earned this week" from your shifts. 0 = off.
PAY_RATE=0
# A day's focus goal in minutes: the ring on the control room's Focus panel.
FOCUS_GOAL_MINUTES=135
# News (Google News RSS, no key): which edition. US, GB, CA, AU, IN...
NEWS_REGION=US
# Whoop (DEPLOY section 7j): an app at developer.whoop.com, then
# `python3 scripts/whoop_auth.py` fills in the refresh token. Blank = no Whoop.
# Whoop swaps the token on every use; she keeps the current one on her volume.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REFRESH_TOKEN=
# Your bank, card and Fidelity, read-only (DEPLOY section 7k): a SimpleFIN Bridge
# account, then `python3 scripts/simplefin_auth.py` fills this in. It's a
# password. Blank = no bank. She warns you once a day when checking and savings
# drop below BANK_LOW_BALANCE dollars (0 = never).
SIMPLEFIN_ACCESS_URL=
BANK_LOW_BALANCE=50
# Room mode (the control room's Room button): she joins in when she hears her name.
# Transcribed on the box by faster-whisper (the model downloads once into her models
# volume); blank uses the voice-note transcriber (Groq) instead.
ROOM_STT_MODEL=base.en
ROOM_WINDOW_SECONDS=120
ROOM_WAKE_WORDS=sloane,sloan,slone
# Research (/research): minutes of searching and reading on your Claude plan per run.
RESEARCH_DAILY=10
RESEARCH_TIMEOUT_SECONDS=600
# Monitors ("let me know when..."): a question for the web is a lookup each check,
# so at most this many at once, each checked every few hours; any monitor ends
# after MONITOR_DAYS if it never happens.
MONITOR_QUESTIONS=5
MONITOR_QUESTION_HOURS=6
MONITOR_DAYS=30

# --- the workshop: features she builds on herself (DEPLOY section 7h) --------
# A fine-grained GitHub token for her own repo only: Contents and Pull requests
# Read and write; Actions, Checks and Metadata Read-only. The installer asks for
# it. Blank: ideas and plans still work, nothing is built.
GITHUB_TOKEN=
# GITHUB_REPO=landenm999-coder/sloane
# The model her builds use (cheaper than chat, still a strong coder).
WORKSHOP_MODEL=sonnet
# At night: build what you queued, then (with room left) one idea of her own.
WORKSHOP_NIGHTLY=true
NIGHTLY_BUILDS=2
NIGHTLY_OWN_IDEAS=1

# --- thinking on her own -----------------------------------------------------
# A few times a day (evenings on weekdays; through the day at weekends) she
# looks over everything and says the one thing worth saying, if there is one.
THINK=true

# --- behaviour -------------------------------------------------------------
# What she calls you when she addresses you: your name, or "sir".
ADDRESS_AS=Landen
# Web lookups for what she can't know from here (news, prices, scores), on
# your own messages only, through the Claude CLI's search tools and nothing else.
WEB_LOOKUP=true
TIMEZONE=America/Denver
# Leave unset outside Docker: the API then listens on 127.0.0.1 only. The image
# sets 0.0.0.0 inside the container; compose publishes it on loopback.
# BIND_HOST=127.0.0.1
LOG_LEVEL=INFO

# Context budget per tier, in tokens. Tiers 1 and 2 ride in every prompt.
BUDGET_STATE=1500
BUDGET_WORKING_SET=1500
BUDGET_EPISODES=2000
# FACTS: school rows first, then the skills' lines (weather, lists, habits ...).
BUDGET_ENTITIES=2000
# The running conversation she reads back (what "it" and "why" refer to).
BUDGET_CONVERSATION=2500
CONVERSATION_HOURS=24
CONVERSATION_MESSAGES=40

# Ceilings for SCHEDULED work only -- your own messages are never rationed.
# A brief over budget is deferred and says why in /jobs.
DAILY_JOB_BUDGET=40
DAILY_BULK_BUDGET=800

# Retrieval decay: cosine similarity * 0.5 ** (age_days / half_life).
RECENCY_HALF_LIFE_DAYS=14
RETRIEVAL_LIMIT=12
# Of those, seats for the most relevant memories however old: long memory.
RECALL_LASTING=4
